# ==============================================================================
# Environment Configuration Template (.env.example)
# Duplicate this file to:
#   - .env.development (for local development)
#   - .env.production  (for production deployment)
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Database Connection (MongoDB)
# Local: mongodb://localhost:27017/portal
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/portal_prod?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/portal

# Session Secret (Used for express-session cookie encryption)
SESSION_SECRET=replace_with_a_secure_session_secret

# JWT Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret
JWT_COOKIE_EXPIRES_IN=3
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailing / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Nezuko Portal

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Swagger API Documentation Server URL
SWAGGER_SERVER_URL=http://localhost:3000
